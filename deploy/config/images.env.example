# Copy to .env only after replacing the gateway sentinel with the immutable
# digest emitted by the accepted candidate workflow. The development
# quickstart uses configurable version tags when this file is absent.
PAG_IMAGE=ghcr.io/alejbormeg/portable-ai-gateway@sha256:REPLACE_WITH_ACCEPTED_GATEWAY_DIGEST
PAG_POSTGRES_IMAGE=postgres:17.6-alpine@sha256:747d5ed1fdeeb124b880fbe3d7c6557d2c4064ae41d6b6297d417882effce4be
PAG_VALKEY_IMAGE=valkey/valkey:8.0.3-alpine@sha256:2d4c0ef1884770837be2e8dac9787268cc7b5690073c71fb3f77071f74645891
